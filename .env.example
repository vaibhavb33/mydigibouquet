# ==============================================================================
# Petal & Prose (mydigibouquet.com) — Production Environment Configuration
# Copy to `.env.local` for local customization or configure in hosting secrets.
# NEVER commit `.env` or `.env.local` with real tokens.
# ==============================================================================

# Public canonical base URL used for sitemaps, robots.txt, Open Graph tags, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://mydigibouquet.com

# Database connection URL:
# - Local development / single-node VPS: file:./local.db
# - Production distributed Turso LibSQL: libsql://<db-name>-<org>.turso.io
DATABASE_URL=file:./local.db

# Optional Turso authentication token (required when DATABASE_URL is libsql:// or https://)
# DATABASE_AUTH_TOKEN=

# Optional Gemini API key to enhance Step 3 AI Florist suggestions
# Platform automatically runs deterministic botanical recommendations when unset.
# GEMINI_API_KEY=

# Random secret used only in memory to HMAC-hash IPs inside ephemeral rate limiters
RATE_LIMIT_SALT=replace-with-32-byte-random-hex-in-production

# Privacy-preserving cookieless first-party aggregate analytics ("true" | "false")
# Always honors browser Do-Not-Track (DNT: 1) and Global Privacy Control (Sec-GPC: 1)
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# Force Strict-Transport-Security header when terminating TLS upstream ("true" | "false")
# Keep "false" on plain local HTTP testing
ENABLE_HSTS=false

